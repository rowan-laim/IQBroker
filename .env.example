# IQ Option account credentials for headless HTTP login
IQ_EMAIL=your_email@example.com
IQ_PASSWORD=your_password

# Stored session token (optional - used if email/password not provided)
# IQ_SSID=

# Broker URLs (optional defaults)
IQ_WS_URL=wss://ws.iqoption.com/echo/websocket
IQ_LOGIN_URL=https://auth.iqoption.com/api/v2/login
IQ_TRADEROOM_URL=https://iqoption.com/traderoom

# Logging & browser options
LOG_LEVEL=info
HEADLESS=true
BROWSER_PROFILE_DIR=.browser-profile
